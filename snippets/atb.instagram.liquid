{% comment %}
ATB-SCHEMA{
  "name": "Instagram feed",
  "class": "index-section--flush",
  "id": "instagram",
  "banner": "",
  "icon": "",
  "tags": "",
  "description": "",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID",
      "info": "Enter a unique ID with only letters and numbers, no spaces",
      "default": ""
    },
    {
      "type": "text",
      "id": "atb_title",
      "label": "Heading",
      "info": ""
    },
    {
      "type": "text",
      "id": "atb_username",
      "label": "Username",
      "default": "@username",
      "info": ""
    },
    {
      "type": "text",
      "id": "atb_client_id",
      "label": "Instagram Access Token",
      "info": ""
    },
    {
      "type": "select",
      "id": "atb_count",
      "label": "Number of rows",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1",
      "info": ""
    },
    {
      "type": "checkbox",
      "id": "atb_full_width",
      "label": "Full page width",
      "default": true,
      "info": ""
    },
    {
      "type": "checkbox",
      "id": "atb_divider",
      "label": "Show section divider",
      "default": false,
      "info": ""
    }
  ],
  "warnings": []
}ATB-SCHEMA
{% endcomment %}


{%- include 'atb-render' field:'section_id' -%}
{%- assign section_id = val -%}
{%- include 'atb-render' field:'atb_title' -%}
{%- assign atb_title = val -%}
{%- include 'atb-render' field:'atb_username' -%}
{%- assign atb_username = val -%}
{%- include 'atb-render' field:'atb_client_id' -%}
{%- assign atb_client_id = val -%}
{%- include 'atb-render' field:'atb_count' -%}
{%- assign atb_count = val -%}
{%- include 'atb-render' field:'atb_full_width' -%}
{%- assign atb_full_width = val -%}
{%- include 'atb-render' field:'atb_divider' -%}
{%- assign atb_divider = val -%}
{%- if atb_full_width == blank -%}
{%- assign atb_full_width = false -%}
{%- else -%}
{%- assign atb_full_width = true -%}
{%- endif -%}
{%- if atb_divider == blank -%}
{%- assign atb_divider = false -%}
{%- else -%}
{%- assign atb_divider = true -%}
{%- endif -%}
{%- assign no_image = images['no_image_comparison'] -%}

<section id="shopify-section-{{section_id}}" class="shopify-section index-section--flush">
{%- assign count = atb_count | times: 6 -%}
{%- assign grid_item_width = 'small--one-half medium-up--one-sixth' -%}

{% if atb_divider %}<div class="section--divider">{% endif %}

<div data-section-id="{{ section_id }}" data-section-type="instagram" class="instagram-section">
  {% unless atb_full_width %}
    <div class="page-width">
  {% endunless %}

    {% if atb_title != blank %}
      <header class="section-header">
        <h3 class="section-header__title">{{ atb_title }}</h3>
      </header>
    {% endif %}

    <div class="instagram-feed-wrap instagram-feed-wrap--{{ atb_count }}" data-aos>
      <div class="instagram-feed-wrap__reflow-fix"></div>
      {% if atb_username != blank %}
        {%- assign instagram_username = atb_username | remove: '@' -%}
        <a href="https://www.instagram.com/{{ instagram_username }}" class="instagram-feed__link" target="_blank">@{{ instagram_username }}</a>
      {% endif %}
      {% if atb_client_id != blank %}
        <div
          id="Instafeed-{{section_id}}"
          class="grid grid--uniform grid--no-gutters"
          data-user-id="{{ atb_client_id | split: '.' | first }}"
          data-client-id="{{ atb_client_id | strip }}"
          data-count="{{ count }}"
          data-grid-item-width="{{ grid_item_width }}"></div>
      {% else %}
        <div class="grid grid--uniform grid--no-gutters">
          {% for i in (1..count) %}
            <div class="grid__item {{ grid_item_width }}">
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>

  {% unless atb_full_width %}
    </div>
  {% endunless %}
</div>

{% if atb_divider %}</div>{% endif %}


</section>