{% comment %}
ATB-SCHEMA{
  "name": "Featured collection",
  "class": "index-section",
  "id": "featured-collection",
  "banner": "",
  "icon": "",
  "tags": "",
  "description": "",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID",
      "info": "Enter a unique ID with only letters and numbers, no spaces",
      "default": ""
    },
    {
      "type": "text",
      "id": "atb_title",
      "label": "Heading",
      "default": "Featured collection",
      "info": ""
    },
    {
      "type": "collection",
      "id": "atb_home_featured_products",
      "label": "Collection",
      "info": ""
    },
    {
      "type": "range",
      "id": "atb_per_row",
      "label": "Products per row",
      "default": 4,
      "min": 1,
      "max": 5,
      "step": 1,
      "info": ""
    },
    {
      "type": "range",
      "id": "atb_rows",
      "label": "Rows of products",
      "default": 1,
      "min": 1,
      "max": 5,
      "step": 1,
      "info": ""
    },
    {
      "type": "checkbox",
      "id": "atb_mobile_scrollable",
      "label": "Enable swipe on mobile",
      "default": true,
      "info": ""
    },
    {
      "type": "checkbox",
      "id": "atb_view_all",
      "label": "Show 'View all' link",
      "default": true,
      "info": ""
    },
    {
      "type": "checkbox",
      "id": "atb_divider",
      "label": "Show section divider",
      "default": false,
      "info": ""
    }
  ],
  "warnings": []
}ATB-SCHEMA
{% endcomment %}


{%- include 'atb-render' field:'section_id' -%}
{%- assign section_id = val -%}
{%- include 'atb-render' field:'atb_title' -%}
{%- assign atb_title = val -%}
{%- include 'atb-render' field:'atb_home_featured_products' -%}
{%- assign atb_home_featured_products = val -%}
{%- include 'atb-render' field:'atb_per_row' -%}
{%- assign atb_per_row = val -%}
{%- include 'atb-render' field:'atb_rows' -%}
{%- assign atb_rows = val -%}
{%- include 'atb-render' field:'atb_mobile_scrollable' -%}
{%- assign atb_mobile_scrollable = val -%}
{%- include 'atb-render' field:'atb_view_all' -%}
{%- assign atb_view_all = val -%}
{%- include 'atb-render' field:'atb_divider' -%}
{%- assign atb_divider = val -%}
{%- if atb_mobile_scrollable == blank -%}
{%- assign atb_mobile_scrollable = false -%}
{%- else -%}
{%- assign atb_mobile_scrollable = true -%}
{%- endif -%}
{%- if atb_view_all == blank -%}
{%- assign atb_view_all = false -%}
{%- else -%}
{%- assign atb_view_all = true -%}
{%- endif -%}
{%- if atb_divider == blank -%}
{%- assign atb_divider = false -%}
{%- else -%}
{%- assign atb_divider = true -%}
{%- endif -%}
{%- assign atb_per_row = atb_per_row | plus: 0 -%}
{%- assign atb_rows = atb_rows | plus: 0 -%}
{%- assign no_image = images['no_image_comparison'] -%}

<section id="shopify-section-{{section_id}}" class="shopify-section index-section">
{%- assign per_row = atb_per_row -%}
{%- assign product_limit = per_row | times: atb_rows -%}
{%- assign collection = collections[atb_home_featured_products] -%}

{% if atb_divider %}<div class="section--divider">{% endif %}

<div
  id="CollectionSection-{{ section_id }}"
  data-section-id="{{ section_id }}"
  data-section-type="collection-template">
  {% if atb_title != blank %}
    <div class="page-width">
      <div class="section-header{% if atb_view_all %}{% unless settings.type_headers_align_text %} section-header--with-link{% endunless %}{% endif %}">
        <h2 class="section-header__title">
          {{ atb_title }}
        </h2>
        {% if atb_view_all and atb_rows == 1 %}
          <a href="{{ collections[atb_home_featured_products].url }}" class="btn btn--secondary btn--small section-header__link">{{ 'collections.general.all_of_collection' | t }}</a>
        {% endif %}
      </div>
    </div>
  {% endif %}

  <div class="page-width {% if atb_mobile_scrollable %}page-width--flush-small{% endif %}">
    <div {% if atb_mobile_scrollable %}class="grid-overflow-wrapper"{% endif %}>
      <div class="grid grid--uniform" {% if atb_mobile_scrollable %}data-aos="overflow__animation"{% endif %}>
        {%- assign grid_item_width = 'small--one-half medium-up--one-third' -%}

        {% case per_row %}
        {% when 1 %}
          {%- assign grid_item_width = '' -%}
        {% when 2 %}
          {%- assign grid_item_width = 'medium-up--one-half' -%}
        {% when 3 %}
          {%- assign grid_item_width = 'small--one-half medium-up--one-third' -%}
        {% when 4 %}
          {%- assign grid_item_width = 'small--one-half medium-up--one-quarter' -%}
        {% when 5 %}
          {%- assign grid_item_width = 'small--one-half medium-up--one-fifth' -%}
        {% endcase %}

        {% if atb_home_featured_products == blank or collections[atb_home_featured_products].empty? or collections[atb_home_featured_products].products_count == 0 %}

          {% unless emptyState %}
            {%- assign emptyState = true -%}
          {% endunless %}

          <div class="grid__item">
            <div class="grid grid--uniform">
              {% for i in (1..product_limit) %}
                <div class="grid__item grid-product {{ grid_item_width }}" data-aos="row-of-{{ per_row }}">
                  <div class="grid-product__content">
                    <a href="{{ product.url | within: collection }}" class="grid-product__link {% if sold_out %} grid-product__link--disabled{% endif %}">
                      <div class="grid-product__image-mask">
                        {% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
                        <div class="image-wrap">{{ 'product-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}</div>
                      </div>
                      <div class="grid-product__meta">
                        <div class="grid-product__title">{{ 'home_page.onboarding.product_title' | t }}</div>
                        <div class="grid-product__price">$29</div>
                      </div>
                    </a>
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>

        {% else %}

          {% for product in collections[atb_home_featured_products].products limit: product_limit %}
            {% include 'atb-product-grid-item'   %}
          {% endfor %}

          {% if atb_view_all %}

            {% if atb_rows > 1 %}
              <div class="grid__item text-center {% if atb_mobile_scrollable %}small--hide{% endif %}">
                <a href="{{ collections[atb_home_featured_products].url }}" class="btn">{{ 'collections.general.all_of_collection' | t }}</a>
              </div>
            {% endif %}

            {% if atb_mobile_scrollable %}
              <div class="grid__item grid__item--view-all text-center {{ grid_item_width }} medium-up--hide">
                <a href="{{ collections[atb_home_featured_products].url }}" class="grid-product__see-all">
                  {{ 'collections.general.view_all_products_html' | t: count: collection.products_count }}
                </a>
              </div>
            {% endif %}

          {% endif %}

        {% endif %}
      </div>
    </div>
  </div>
</div>

{% if settings.quick_shop_enable %}
  {% for product in collections[atb_home_featured_products].products limit: product_limit %}
    {% include 'atb-quick-shop-modal'   %}
  {% endfor %}
{% endif %}

{% if atb_divider %}</div>{% endif %}



</section>