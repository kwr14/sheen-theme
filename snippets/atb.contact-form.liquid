{% comment %}
ATB-SCHEMA{
  "name": "Contact form",
  "class": "index-section",
  "id": "contact-form",
  "banner": "",
  "icon": "",
  "tags": "",
  "description": "",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID",
      "info": "Enter a unique ID with only letters and numbers, no spaces",
      "default": ""
    },
    {
      "type": "text",
      "id": "atb_title",
      "label": "Title",
      "default": "Contact us",
      "info": ""
    },
    {
      "type": "checkbox",
      "id": "atb_show_phone",
      "label": "Show phone number",
      "info": ""
    },
    {
      "type": "checkbox",
      "id": "atb_narrow_column",
      "label": "Narrow column",
      "default": true,
      "info": ""
    }
  ],
  "warnings": []
}ATB-SCHEMA
{% endcomment %}


{%- include 'atb-render' field:'section_id' -%}
{%- assign section_id = val -%}
{%- include 'atb-render' field:'atb_title' -%}
{%- assign atb_title = val -%}
{%- include 'atb-render' field:'atb_show_phone' -%}
{%- assign atb_show_phone = val -%}
{%- include 'atb-render' field:'atb_narrow_column' -%}
{%- assign atb_narrow_column = val -%}
{%- if atb_show_phone == blank -%}
{%- assign atb_show_phone = false -%}
{%- else -%}
{%- assign atb_show_phone = true -%}
{%- endif -%}
{%- if atb_narrow_column == blank -%}
{%- assign atb_narrow_column = false -%}
{%- else -%}
{%- assign atb_narrow_column = true -%}
{%- endif -%}
{%- assign no_image = images['no_image_comparison'] -%}

<section id="shopify-section-{{section_id}}" class="shopify-section index-section">
<div class="index-section">
  <div class="page-width">

    <div class="grid">
      <div class="grid__item{% if atb_narrow_column %} medium-up--three-quarters medium-up--push-one-eighth{% endif %}">

        {% if atb_title != blank %}
          <div class="section-header">
            <h2 class="section-header__title">
              {{ atb_title }}
            </h2>
          </div>
        {% endif %}

        <div class="form-vertical">
          {% form 'contact' %}

            {% if form.posted_successfully? %}
              <p class="note note--success">
                {{ 'contact.form.post_success' | t }}
              </p>
            {% endif %}

            {{ form.errors | default_errors }}

            <div class="grid grid--small">
              <div class="grid__item medium-up--one-half">
                <label for="ContactFormName-{{ section_id }}">{{ 'contact.form.name' | t }}</label>
                <input type="text" id="ContactFormName-{{ section_id }}" class="input-full" name="contact[name]" autocapitalize="words" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
              </div>

              <div class="grid__item medium-up--one-half">
                <label for="ContactFormEmail-{{ section_id }}">{{ 'contact.form.email' | t }}</label>
                <input type="email" id="ContactFormEmail-{{ section_id }}" class="input-full" name="contact[email]" autocorrect="off" autocapitalize="off" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}">
              </div>
            </div>

            {% if atb_show_phone %}
              <label for="ContactFormPhone-{{ section_id }}">{{ 'contact.form.phone' | t }}</label>
              <input type="tel" id="ContactFormPhone-{{ section_id }}" class="input-full" name="contact[phone]" pattern="[0-9\-]*" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}">
            {% endif %}

            <label for="ContactFormMessage-{{ section_id }}">{{ 'contact.form.message' | t }}</label>
            <textarea rows="5" id="ContactFormMessage-{{ section_id }}" class="input-full" name="contact[body]">{% if form.body %}{{ form.body }}{% endif %}</textarea>

            <button type="submit" class="btn">
              {{ 'contact.form.send' | t }}
            </button>

          {% endform %}
        </div>
      </div>
    </div>
  </div>
</div>


</section>