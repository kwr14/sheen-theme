{% comment %}
ATB-SCHEMA{
  "name": "Large image with text box",
  "class": "index-section--flush",
  "id": "background-image-text",
  "banner": "",
  "icon": "",
  "tags": "",
  "description": "",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID",
      "info": "Enter a unique ID with only letters and numbers, no spaces",
      "default": ""
    },
    {
      "type": "text",
      "id": "atb_subtitle",
      "label": "Subheading",
      "default": "Impressive",
      "info": ""
    },
    {
      "type": "text",
      "id": "atb_title",
      "label": "Heading",
      "default": "Large image with text box",
      "info": ""
    },
    {
      "type": "wysiwyg",
      "id": "atb_text",
      "label": "Text",
      "default": "<p>Pair large text with a full-width image to draw attention to an important detail of your brand or product line.</p>",
      "info": ""
    },
    {
      "type": "text",
      "id": "atb_button_label",
      "label": "Button label",
      "info": ""
    },
    {
      "type": "text",
      "id": "atb_button_link",
      "label": "Button link",
      "info": ""
    },
    {
      "type": "image_picker",
      "id": "atb_image",
      "label": "Image",
      "info": ""
    },
    {
      "type": "select",
      "id": "atb_focal_point",
      "label": "Image focal point",
      "info": "",
      "default": "center",
      "options": [
        {
          "value": "20% 0",
          "label": "Top left"
        },
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "80% 0",
          "label": "Top right"
        },
        {
          "value": "20% 50%",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Middle"
        },
        {
          "value": "80% 50%",
          "label": "Right"
        },
        {
          "value": "20% 100%",
          "label": "Bottom left"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        },
        {
          "value": "80% 100%",
          "label": "Bottom right"
        }
      ]
    },
    {
      "type": "color",
      "id": "atb_color_border",
      "label": "Image color",
      "info": "",
      "default": "#f4f4f4"
    },
    {
      "type": "select",
      "id": "atb_layout",
      "label": "Layout",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Text on left"
        },
        {
          "value": "right",
          "label": "Text on right"
        }
      ],
      "info": ""
    },
    {
      "type": "range",
      "id": "atb_height",
      "label": "Section height",
      "default": 550,
      "min": 450,
      "max": 750,
      "step": 100,
      "unit": "px",
      "info": ""
    },
    {
      "type": "checkbox",
      "id": "atb_framed",
      "label": "Add frame",
      "default": false,
      "info": ""
    },
    {
      "type": "checkbox",
      "id": "atb_parallax",
      "label": "Enable parallax",
      "default": true,
      "info": ""
    }
  ],
  "warnings": []
}ATB-SCHEMA
{% endcomment %}


{%- include 'atb-render' field:'section_id' -%}
{%- assign section_id = val -%}
{%- include 'atb-render' field:'atb_subtitle' -%}
{%- assign atb_subtitle = val -%}
{%- include 'atb-render' field:'atb_title' -%}
{%- assign atb_title = val -%}
{%- include 'atb-render' field:'atb_text' -%}
{%- assign atb_text = val -%}
{%- include 'atb-render' field:'atb_button_label' -%}
{%- assign atb_button_label = val -%}
{%- include 'atb-render' field:'atb_button_link' -%}
{%- assign atb_button_link = val -%}
{%- include 'atb-render' field:'atb_image' -%}
{%- assign atb_image = val -%}
{%- include 'atb-render' field:'atb_focal_point' -%}
{%- assign atb_focal_point = val -%}
{%- include 'atb-render' field:'atb_color_border' -%}
{%- assign atb_color_border = val -%}
{%- include 'atb-render' field:'atb_layout' -%}
{%- assign atb_layout = val -%}
{%- include 'atb-render' field:'atb_height' -%}
{%- assign atb_height = val -%}
{%- include 'atb-render' field:'atb_framed' -%}
{%- assign atb_framed = val -%}
{%- include 'atb-render' field:'atb_parallax' -%}
{%- assign atb_parallax = val -%}
{%- if atb_framed == blank -%}
{%- assign atb_framed = false -%}
{%- else -%}
{%- assign atb_framed = true -%}
{%- endif -%}
{%- if atb_parallax == blank -%}
{%- assign atb_parallax = false -%}
{%- else -%}
{%- assign atb_parallax = true -%}
{%- endif -%}
{%- assign atb_height = atb_height | plus: 0 -%}
{%- assign atb_image_key = atb_image| split: '/files/' | last -%}{%- assign atb_image = images[atb_image_key] -%}{%- assign no_image = images['no_image_comparison'] -%}

<section id="shopify-section-{{section_id}}" class="shopify-section index-section--flush">
{% style %}
  @media screen and (max-width: 768px) {
    .background-media-text--{{ section_id }} {
      background: {{ atb_color_border }};
    }
  }
{% endstyle %}

<div
  data-section-id="{{ section_id }}"
  data-section-type="background-image"
  class="background-media-text background-media-text--{{ section_id }} background-media-text--{{ atb_height }} loaded"
  data-aos="background-media-text__animation"
  {% if atb_parallax %}data-parallax="true"{% endif %}
  >

  <div class="background-media-text__container">
    {% if atb_parallax %}
      <div class="parallax-container">
        {% if atb_image != blank %}
          {% style %}
            .background-media-text--{{ section_id }} .background-media-text__image {
              background-position: {{ atb_focal_point }};
            }
          {% endstyle %}
          <div
            class="parallax-image background-media-text__image lazyload"
            {% if atb_image != blank %}
              data-bgset="{% include 'atb-bgset' , image: atb_image  %}"
              data-sizes="auto"
            {% endif %}></div>
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>
    {% else %}
      {% if atb_image != blank %}
        {% style %}
          .background-media-text__image--{{ section_id }} {
            object-position: {{ atb_focal_point }};
            font-family: "object-fit: cover; object-position: {{ atb_focal_point }};";
          }
        {% endstyle %}

        {%- assign img_url = atb_image | img_url: '1x1' | replace: '_1x1.', '_{width}x.' -%}

        <img
          class="image-fit background-media-text__image background-media-text__image--{{ section_id }} lazyload"
          src=""
          data-src="{{ img_url }}"
          data-aspectratio="{{ atb_image.aspect_ratio }}"
          data-sizes="auto"
          data-parent-fit="cover"
          alt="{{ atb_image.alt | escape }}">
        <noscript>
          <img
            class="image-fit background-media-text__image background-media-text__image--{{ section_id }} lazyloaded"
            src="{{ atb_image | img_url: '1800x' }}"
            alt="{{ atb_image.alt }}">
        </noscript>
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {% endif %}
    {% endif %}
  </div>
  {% if atb_subtitle != blank or atb_title != blank or atb_text != blank %}
    <div class="background-media-text__inner">
      <div class="background-media-text__aligner background-media-text--{{ atb_layout }}">
        <div class="animation-cropper">
          <div class="animation-contents">
            <div class="background-media-text__text{% if atb_framed %} background-media-text__text--framed{% endif %}">
              {% if atb_subtitle %}
                <p class="h5">{{ atb_subtitle }}</p>
              {% endif %}
              {% if atb_title != blank %}
                <p class="h3">{{ atb_title | escape }}</p>
              {% endif %}
              {% if atb_text != blank %}
                <div class="rte background-media-text__subtext">{{ atb_text }}</div>
              {% endif %}
              {% if atb_button_label != blank and atb_button_link != blank %}
                <a href="{{ atb_button_link }}" class="btn">
                  {{ atb_button_label }}
                </a>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    </div>
  {% endif %}
</div>

<div class="background-media-text__spacer background-media-text--{{ atb_height }}"></div>


</section>