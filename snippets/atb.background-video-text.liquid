{% comment %}
ATB-SCHEMA{
  "name": "Large video with text box",
  "class": "index-section--flush",
  "id": "background-video-text",
  "banner": "",
  "icon": "",
  "tags": "",
  "description": "",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID",
      "info": "Enter a unique ID with only letters and numbers, no spaces",
      "default": ""
    },
    {
      "type": "text",
      "id": "atb_subtitle",
      "label": "Subheading",
      "default": "Impressive",
      "info": ""
    },
    {
      "type": "text",
      "id": "atb_title",
      "label": "Heading",
      "default": "Large video with text box",
      "info": ""
    },
    {
      "type": "wysiwyg",
      "id": "atb_text",
      "label": "Text",
      "default": "<p>Pair large text with a full-width video to showcase your brand's lifestyle video or to describe and showcase an important detail of your products.</p>",
      "info": ""
    },
    {
      "type": "text",
      "id": "atb_button_label",
      "label": "Button label",
      "info": ""
    },
    {
      "type": "text",
      "id": "atb_button_link",
      "label": "Button link",
      "info": ""
    },
    {
      "type": "text",
      "id": "atb_video_url",
      "label": "Background video link",
      "default": "https://www.youtube.com/watch?v=_9VUPq3SxOc",
      "info": ""
    },
    {
      "type": "color",
      "id": "atb_color_border",
      "label": "Video color",
      "info": "",
      "default": "#f4f4f4"
    },
    {
      "type": "select",
      "id": "atb_layout",
      "label": "Layout",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Text on left"
        },
        {
          "value": "right",
          "label": "Text on right"
        }
      ],
      "info": ""
    },
    {
      "type": "range",
      "id": "atb_height",
      "label": "Section height",
      "default": 550,
      "min": 450,
      "max": 750,
      "step": 100,
      "unit": "px",
      "info": ""
    }
  ],
  "warnings": []
}ATB-SCHEMA
{% endcomment %}


{%- include 'atb-render' field:'section_id' -%}
{%- assign section_id = val -%}
{%- include 'atb-render' field:'atb_subtitle' -%}
{%- assign atb_subtitle = val -%}
{%- include 'atb-render' field:'atb_title' -%}
{%- assign atb_title = val -%}
{%- include 'atb-render' field:'atb_text' -%}
{%- assign atb_text = val -%}
{%- include 'atb-render' field:'atb_button_label' -%}
{%- assign atb_button_label = val -%}
{%- include 'atb-render' field:'atb_button_link' -%}
{%- assign atb_button_link = val -%}
{%- include 'atb-render' field:'atb_video_url' -%}
{%- assign atb_video_url = val -%}
{%- include 'atb-render' field:'atb_color_border' -%}
{%- assign atb_color_border = val -%}
{%- include 'atb-render' field:'atb_layout' -%}
{%- assign atb_layout = val -%}
{%- include 'atb-render' field:'atb_height' -%}
{%- assign atb_height = val -%}
{%- assign atb_height = atb_height | plus: 0 -%}
{%- assign no_image = images['no_image_comparison'] -%}

<section id="shopify-section-{{section_id}}" class="shopify-section index-section--flush">
{% style %}
  @media screen and (max-width: 768px) {
    .background-media-text--{{ section_id }} {
      background: {{ atb_color_border }};
    }
  }
{% endstyle %}

<div
  data-section-id="{{ section_id }}"
  data-section-type="video-section"
  class="video-parent-section background-media-text background-media-text--{{ section_id }} background-media-text--{{ atb_height }}"
  data-aos="background-media-text__animation">

  <div class="background-media-text__video">
    {% include 'atb-video-div' , section_id: section_id, url: atb_video_url  %}
  </div>

  {% if atb_subtitle != blank or atb_title != blank or atb_text != blank %}
    <div class="background-media-text__inner">
      <div class="background-media-text__aligner background-media-text--{{ atb_layout }}">
        <div class="animation-cropper">
          <div class="animation-contents">
            <div class="background-media-text__text">
              {% if atb_subtitle %}
                <p class="h5">{{ atb_subtitle }}</p>
              {% endif %}
              {% if atb_title != blank %}
                <p class="h3 text-spacing">{{ atb_title | escape }}</p>
              {% endif %}
              {% if atb_text != blank %}
                <div class="rte background-media-text__subtext">{{ atb_text }}</div>
              {% endif %}

              {% if atb_button_label != blank %}
                {%- assign link_href = atb_button_link -%}
                {% if atb_button_link == blank %}
                  {%- assign link_href = atb_video_url -%}
                {% endif %}

                <a href="{{ link_href }}" class="btn js-no-transition">
                  {%- if link_href contains 'youtube.com/watch' or link_href contains 'youtu.be/' -%}
                    <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-play" viewBox="0 0 32 32"><path class="st0" d="M9.3 6.2l17.1 9.7-17.1 9.7"/></svg>
                  {%- endif -%}
                  {{ atb_button_label }}
                </a>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    </div>
  {% endif %}
</div>

<div class="background-media-text__spacer background-media-text--{{ atb_height }}"></div>


</section>