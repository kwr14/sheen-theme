{% comment %}
ATB-SCHEMA{
  "name": "Video hero",
  "class": "index-section--hero",
  "id": "hero-video",
  "banner": "",
  "icon": "",
  "tags": "",
  "description": "",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID",
      "info": "Enter a unique ID with only letters and numbers, no spaces",
      "default": ""
    },
    {
      "type": "textarea",
      "id": "atb_title",
      "label": "Heading",
      "default": "Bring your\nbrand to life.",
      "info": ""
    },
    {
      "type": "range",
      "id": "atb_title_size",
      "label": "Heading text size",
      "default": 80,
      "min": 40,
      "max": 100,
      "unit": "px",
      "info": ""
    },
    {
      "type": "text",
      "id": "atb_subheading",
      "label": "Subheading",
      "default": "Seamless hero videos",
      "info": ""
    },
    {
      "type": "text",
      "id": "atb_link_text",
      "label": "Button text",
      "default": "Optional button",
      "info": ""
    },
    {
      "type": "text",
      "id": "atb_link",
      "label": "Button link",
      "info": ""
    },
    {
      "type": "color",
      "id": "atb_color_accent",
      "label": "Buttons",
      "default": "rgba(0,0,0,0)",
      "info": ""
    },
    {
      "type": "select",
      "id": "atb_text_align",
      "label": "Text alignment",
      "default": "vertical-center horizontal-center",
      "options": [
        {
          "value": "vertical-center horizontal-left",
          "label": "Center left"
        },
        {
          "value": "vertical-center horizontal-center",
          "label": "Center"
        },
        {
          "value": "vertical-center horizontal-right",
          "label": "Center right"
        },
        {
          "value": "vertical-bottom horizontal-left",
          "label": "Bottom left"
        },
        {
          "value": "vertical-bottom horizontal-center",
          "label": "Bottom center"
        },
        {
          "value": "vertical-bottom horizontal-right",
          "label": "Bottom right"
        }
      ],
      "info": ""
    },
    {
      "type": "text",
      "id": "atb_video_url",
      "label": "Background video link",
      "default": "https://www.youtube.com/watch?v=_9VUPq3SxOc",
      "info": ""
    },
    {
      "type": "select",
      "id": "atb_section_height",
      "label": "Desktop height",
      "default": "650px",
      "options": [
        {
          "label": "450px",
          "value": "450px"
        },
        {
          "label": "550px",
          "value": "550px"
        },
        {
          "label": "650px",
          "value": "650px"
        },
        {
          "label": "750px",
          "value": "750px"
        },
        {
          "label": "Full screen",
          "value": "100vh"
        }
      ],
      "info": ""
    },
    {
      "type": "select",
      "id": "atb_mobile_height",
      "label": "Mobile height",
      "default": "auto",
      "options": [
        {
          "label": "Auto",
          "value": "auto"
        },
        {
          "label": "250px",
          "value": "250px"
        },
        {
          "label": "300px",
          "value": "300px"
        },
        {
          "label": "400px",
          "value": "400px"
        },
        {
          "label": "500px",
          "value": "500px"
        },
        {
          "label": "Full screen",
          "value": "100vh"
        }
      ],
      "info": ""
    }
  ],
  "warnings": []
}ATB-SCHEMA
{% endcomment %}


{%- include 'atb-render' field:'section_id' -%}
{%- assign section_id = val -%}
{%- include 'atb-render' field:'atb_title' -%}
{%- assign atb_title = val -%}
{%- include 'atb-render' field:'atb_title_size' -%}
{%- assign atb_title_size = val -%}
{%- include 'atb-render' field:'atb_subheading' -%}
{%- assign atb_subheading = val -%}
{%- include 'atb-render' field:'atb_link_text' -%}
{%- assign atb_link_text = val -%}
{%- include 'atb-render' field:'atb_link' -%}
{%- assign atb_link = val -%}
{%- include 'atb-render' field:'atb_color_accent' -%}
{%- assign atb_color_accent = val -%}
{%- include 'atb-render' field:'atb_text_align' -%}
{%- assign atb_text_align = val -%}
{%- include 'atb-render' field:'atb_video_url' -%}
{%- assign atb_video_url = val -%}
{%- include 'atb-render' field:'atb_section_height' -%}
{%- assign atb_section_height = val -%}
{%- include 'atb-render' field:'atb_mobile_height' -%}
{%- assign atb_mobile_height = val -%}
{%- assign atb_title_size = atb_title_size | plus: 0 -%}
{%- assign no_image = images['no_image_comparison'] -%}

<section id="shopify-section-{{section_id}}" class="shopify-section index-section--hero">
{% style %}
  .hero--{{ section_id }} .hero__title {
    font-size: {{ atb_title_size | times: 0.5 }}px;
  }
  @media only screen and (min-width: 769px) {
    .hero--{{ section_id }} .hero__title {
      font-size: {{ atb_title_size }}px;
    }
  }

  {%- assign accent_exists = false -%}
  {% unless atb_color_accent contains 'rgba(0,0,0,0)' %}
    {%- assign accent_exists = true -%}
      .hero--{{ section_id }} .btn {
        background: {{ atb_color_accent }} !important;
        border-color: {{ atb_color_accent }} !important;

        {%- assign accent_brightness = atb_color_accent | color_extract: 'lightness' -%}

        {% if accent_brightness > 40 %}
          color: #000 !important;
        {% endif %}
      }

      {% if settings.button_style == 'angled' %}
        .hero--{{ section_id }} .btn:before,
        .hero--{{ section_id }} .btn:after {
          background: {{ atb_color_accent }} !important;
          border-color: {{ atb_color_accent }} !important;
        }
      {% endif %}
  {% endunless %}
{% endstyle %}

<div
  data-section-id="{{ section_id }}"
  data-section-type="video-section"
  class="video-parent-section hero hero--{{ section_id }} hero--{{ atb_section_height }} hero--mobile--{{ atb_mobile_height }}"
  data-aos="hero__animation">

  <div class="hero__media hero__media--{{ section_id }}">
    <div class="hero__media-container">

      {% if atb_video_url contains 'youtube.com/watch' %}
        {%- assign video_id = atb_video_url | split: 'v=' -%}
        {%- assign video_id = video_id[1] | split: '&' | first -%}
        <div
          id="YouTubeVideo-{{ section_id }}"
          data-video-id="{{ video_id }}"></div>
      {% endif %}

      {% if atb_video_url contains 'youtu.be/' %}
        {%- assign video_id = atb_video_url | split: '.be/' -%}
        {%- assign video_id = video_id[1] | split: '&' | first -%}
        <div
          id="YouTubeVideo-{{ section_id }}"
          data-video-id="{{ video_id }}"></div>
      {% endif %}

      {% if atb_video_url contains 'vimeo.com' %}
        {%- assign video_id = atb_video_url | split: '.com/' -%}
        {%- assign video_id = video_id[1] | split: '/' | first -%}
        <div
          id="Vimeo-{{ section_id }}"
          data-video-id="{{ video_id }}"></div>
      {% endif %}

      {% if atb_video_url contains '.mp4' %}
        <video
          id="Mp4Video-{{ section_id }}"
          src="{{ atb_video_url }}"
          loop muted playsinline autoplay></video>
      {% endif %}

    </div>
  </div>

  <div class="hero__text-wrap">
    <div class="page-width">
      <div class="hero__text-content {{ atb_text_align }}">
        <div class="hero__text-shadow">
          {% if atb_video_url contains 'vimeo.com' %}
            <button type="button" id="VimeoTrigger-{{ section_id }}" class="vimeo-mobile-trigger medium-up--hide">
              <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-play" viewBox="0 0 32 32"><path class="st0" d="M9.3 6.2l17.1 9.7-17.1 9.7"/></svg>
            </button>
          {% endif %}

          {% unless atb_title == blank %}
            <h2 class="h1 hero__title">
              <div class="animation-cropper"><div class="animation-contents">
              {{ atb_title | newline_to_br }}
              </div></div>
            </h2>
          {% endunless %}
          {% if atb_subheading or atb_link %}
            {% unless atb_subheading == blank %}
              <div class="hero__subtitle">
                <div class="animation-cropper"><div class="animation-contents">
                  {{ atb_subheading | escape }}
                </div></div>
              </div>
            {% endunless %}
            {% if atb_link_text != blank %}
              {%- assign link_href = atb_link -%}
              {% if atb_link == blank %}
                {%- assign link_href = atb_video_url -%}
              {% endif %}
              <div class="hero__link">
                <div class="animation-cropper">
                  <div class="animation-contents">
                    <a href="{{ link_href }}" class="btn{% if atb_color_accent and atb_color_accent == 'rgba(0,0,0,0)' %} btn--inverse{% endif %}">
                      {%- if link_href contains 'youtube.com/watch' or link_href contains 'youtu.be/' -%}
                        <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-play" viewBox="0 0 32 32"><path class="st0" d="M9.3 6.2l17.1 9.7-17.1 9.7"/></svg>
                      {%- endif -%}
                      {{ atb_link_text }}
                    </a>
                  </div>
                </div>
              </div>
            {% endif %}
          {% endif %}
        </div>
      </div>
    </div>
  </div>

</div>


</section>