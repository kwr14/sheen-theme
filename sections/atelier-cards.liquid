{% comment %}
  Atelier homepage: a row of image cards. "Tall cards" shows a portrait photo with a title and a line of text
  (used for "Shop by how you'll use it"); "Labelled tiles" shows a landscape photo with a label (used for brands).
  A card can take an image, or fall back to its collection's image. Styles live in assets/atelier.css.
{% endcomment %}
{{ 'atelier.css' | asset_url | stylesheet_tag }}
{%- assign hf = settings.type_header_font_family -%}
<style>#atl-{{ section.id }} { --atl-heading-font: {{ hf.family }}, {{ hf.fallback_families }}; }</style>
<div class="atl" id="atl-{{ section.id }}">
  <div class="atl-w atl-pad{% if section.settings.pad_end %} atl-pad--end{% endif %}">
    <div class="atl-head">
      <h2 class="atl-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.link_label != blank -%}
        <a class="atl-more" href="{{ section.settings.link | default: '/collections/all' }}">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>
    <div class="atl-grid" style="--atl-cols: {{ section.settings.columns }};">
      {%- for block in section.blocks -%}
        {%- assign col = block.settings.collection -%}
        {%- if col != blank and col.handle == blank -%}{%- assign col = collections[col] -%}{%- endif -%}
        {%- assign img = block.settings.image | default: col.image -%}
        {%- assign title = block.settings.title | default: col.title -%}
        {%- assign href = block.settings.link | default: col.url | default: '/collections/all' -%}
        {%- capture picture -%}
          {%- if img != blank -%}
            {%- if block.settings.image != blank -%}{%- assign card_alt = img.alt | default: title -%}{%- else -%}{%- assign card_alt = title -%}{%- endif -%}
            {{ img | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '300, 500, 700, 1000', sizes: '(max-width: 900px) 50vw, 25vw', alt: card_alt }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag }}
          {%- endif -%}
        {%- endcapture -%}
        {%- if section.settings.style == 'tile' -%}
          <a class="atl-tile" href="{{ href }}" {{ block.shopify_attributes }}>{{ picture }}<span>{{ title }}</span></a>
        {%- else -%}
          <a class="atl-card" href="{{ href }}" {{ block.shopify_attributes }}>
            <div class="atl-card__img">{{ picture }}</div>
            <h3>{{ title }}</h3>
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Atelier cards",
  "class": "atelier-section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by how you’ll use it" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "All fabrics" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "select", "id": "style", "label": "Card style", "default": "card", "options": [
      { "value": "card", "label": "Tall cards with text" },
      { "value": "tile", "label": "Labelled tiles" }
    ] },
    { "type": "range", "id": "columns", "label": "Cards per row", "min": 2, "max": 4, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "pad_end", "label": "Extra space below", "default": false }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Leave blank to use the collection's image." },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title", "info": "Leave blank to use the collection's name." },
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "url", "id": "link", "label": "Link", "info": "Leave blank to link to the collection." }
      ]
    }
  ],
  "presets": [ { "name": "Atelier cards", "category": "Collection", "blocks": [ { "type": "card" }, { "type": "card" }, { "type": "card" }, { "type": "card" } ] } ]
}
{% endschema %}
