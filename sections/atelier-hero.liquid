{% comment %}
  Atelier homepage: hero with one clear promise, two buttons and a room photo,
  followed by a strip of short trust points (blocks). Styles live in assets/atelier.css.
{% endcomment %}
{{ 'atelier.css' | asset_url | stylesheet_tag }}
{%- assign hf = settings.type_header_font_family -%}
<style>#atl-{{ section.id }} { --atl-heading-font: {{ hf.family }}, {{ hf.fallback_families }}; }</style>
<div class="atl" id="atl-{{ section.id }}">
  <div class="atl-w">
    <div class="atl-hero">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="atl-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="atl-h1">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<div class="atl-lead">{{ section.settings.text }}</div>{%- endif -%}
        <div class="atl-btns">
          {%- if section.settings.button_label != blank -%}
            <a class="atl-btn atl-btn--dark" href="{{ section.settings.button_link | default: '/collections/all' }}">{{ section.settings.button_label }}</a>
          {%- endif -%}
          {%- if section.settings.button2_label != blank -%}
            <a class="atl-btn atl-btn--line" href="{{ section.settings.button2_link | default: '/pages/contact-us' }}">{{ section.settings.button2_label }}</a>
          {%- endif -%}
        </div>
      </div>
      <figure class="atl-hero__media">
        <div class="atl-hero__img">
          {%- if section.settings.image != blank -%}
            {%- assign hero_alt = section.settings.image.alt | default: section.settings.heading -%}
            {{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1500, 1800', sizes: '(max-width: 900px) 100vw, 58vw', alt: hero_alt }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          {%- endif -%}
        </div>
        {%- if section.settings.credit != blank -%}<figcaption class="atl-credit">{{ section.settings.credit }}</figcaption>{%- endif -%}
      </figure>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="atl-trust" style="--atl-cols: {{ section.blocks.size }};">
        {%- for block in section.blocks -%}
          {%- capture icon -%}
            {%- case block.settings.icon -%}
              {%- when 'delivery' -%}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="17" r="1.8"/><circle cx="17" cy="17" r="1.8"/></svg>
              {%- when 'workshop' -%}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M8.1 8.1 20 20M8.1 15.9 20 4"/></svg>
              {%- when 'pin' -%}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
              {%- when 'star' -%}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l2.6 5.6 6.1.7-4.5 4.2 1.2 6L12 16.6 6.6 19.5l1.2-6L3.3 9.3l6.1-.7z"/></svg>
              {%- when 'swatch' -%}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="3" width="10" height="14" rx="1"/><path d="M14 7l5 1.5-3 12L8 18"/></svg>
              {%- else -%}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 12a9 9 0 1 0 18 0 9 9 0 0 0-18 0zM8 12l3 3 5-6"/></svg>
            {%- endcase -%}
          {%- endcapture -%}
          {%- if block.settings.link != blank -%}
            <a class="atl-trust__item" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ icon }}<p><b>{{ block.settings.title }}</b><span>{{ block.settings.text }}</span></p></a>
          {%- else -%}
            <div class="atl-trust__item" {{ block.shopify_attributes }}>{{ icon }}<p><b>{{ block.settings.title }}</b><span>{{ block.settings.text }}</span></p></div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Atelier hero",
  "class": "atelier-section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Designer fabrics · made to measure · East Sheen, London" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Beautiful fabric, made into something you’ll keep" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Choose from Harlequin, Sanderson, Zoffany and more, then let our workshop turn it into curtains, blinds or a re-upholstered favourite.</p>" },
    { "type": "text", "id": "button_label", "label": "First button label", "default": "Shop fabrics" },
    { "type": "url", "id": "button_link", "label": "First button link" },
    { "type": "text", "id": "button2_label", "label": "Second button label", "default": "Request a quote" },
    { "type": "url", "id": "button2_link", "label": "Second button link", "info": "Leave blank for the contact page." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "credit", "label": "Photo credit", "info": "Shown under the image. Leave blank to hide." }
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Trust point",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "check", "options": [
          { "value": "check", "label": "Tick" },
          { "value": "delivery", "label": "Delivery van" },
          { "value": "workshop", "label": "Scissors" },
          { "value": "pin", "label": "Map pin" },
          { "value": "star", "label": "Star" },
          { "value": "swatch", "label": "Fabric swatch" }
        ] },
        { "type": "text", "id": "title", "label": "Title", "default": "Made to measure" },
        { "type": "text", "id": "text", "label": "Text", "default": "in our own workshop" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [ { "name": "Atelier hero", "category": "Image", "blocks": [ { "type": "trust" }, { "type": "trust" }, { "type": "trust" } ] } ]
}
{% endschema %}
