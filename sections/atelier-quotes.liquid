{% comment %}
  Atelier homepage: customer reviews as quiet cards (blocks). Styles live in assets/atelier.css.
{% endcomment %}
{{ 'atelier.css' | asset_url | stylesheet_tag }}
{%- assign hf = settings.type_header_font_family -%}
<style>#atl-{{ section.id }} { --atl-heading-font: {{ hf.family }}, {{ hf.fallback_families }}; }</style>
<div class="atl" id="atl-{{ section.id }}">
  <div class="atl-w atl-pad">
    <div class="atl-head">
      <h2 class="atl-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.link_label != blank and section.settings.link != blank -%}
        <a class="atl-more" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>
    <div class="atl-quotes">
      {%- for block in section.blocks -%}
        <figure class="atl-quote" {{ block.shopify_attributes }}>
          <blockquote class="atl-quote__text">{{ block.settings.text }}</blockquote>
          {%- if block.settings.author != blank -%}<figcaption><cite>{{ block.settings.author }}</cite></figcaption>{%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Atelier reviews",
  "class": "atelier-section",
  "max_blocks": 9,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What our customers say" },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Review",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Add a customer review here.</p>" },
        { "type": "text", "id": "author", "label": "Name" }
      ]
    }
  ],
  "presets": [ { "name": "Atelier reviews", "category": "Text", "blocks": [ { "type": "quote" }, { "type": "quote" }, { "type": "quote" } ] } ]
}
{% endschema %}
