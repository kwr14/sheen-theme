  "class": "section-furniture-configurator",
  "settings": [
    { "type": "color", "id": "background", "label": "Background", "default": "#f6f3ee" },
    { "type": "url", "id": "landing_url", "label": "Furniture landing page link", "info": "Used in the breadcrumb" },
    { "type": "text", "id": "landing_label", "label": "Breadcrumb label", "default": "Furniture" },
    { "type": "text", "id": "view_labels", "label": "View names for untagged photos", "default": "Front, Side, Back, Detail", "info": "Fabric-specific photos are named by their alt text, e.g. '#LF2282C/001 Side'" },
    { "type": "text", "id": "generic_photo_note", "label": "Label on photos not in the chosen fabric", "default": "Shown in a sample fabric" },
    { "type": "checkbox", "id": "show_illustration", "label": "Show an illustration in the chosen colour", "default": true, "info": "Used when a colour has no photos of its own (alt text '#CODE View')" },
    { "type": "text", "id": "illustration_label", "label": "Illustration view name", "default": "Your colour", "info": "Only used if the drawing script can't provide its own views (Front, Angle, Side, In a room)." },
    { "type": "text", "id": "illustration_note", "label": "Label on the illustration", "default": "Illustration · colour is indicative" },
    { "type": "text", "id": "render_note", "label": "Label on the 3D renders", "default": "Rendered image · colour is indicative" },
    { "type": "text", "id": "price_note", "label": "Text next to price", "default": "incl. VAT · in your chosen fabric" },
    { "type": "header", "content": "Fabric picker" },
    { "type": "text", "id": "family_label", "label": "Step 1 heading", "default": "Choose a fabric" },
    { "type": "text", "id": "colour_label", "label": "Step 2 heading", "default": "Choose a colour" },
    { "type": "text", "id": "size_label", "label": "Step 3 heading", "default": "Choose a size" },
    { "type": "text", "id": "fabric_label", "label": "Heading for products without the fabric library", "default": "Choose your option" },
    { "type": "text", "id": "choose_text", "label": "Button text before a fabric is chosen", "default": "Choose a fabric" },
    { "type": "checkbox", "id": "show_unapproved", "label": "Show unapproved fabrics (showcase)", "default": false, "info": "Shows fabrics marked 'Not yet approved' to everyone, as a showcase: they can't be bought. Products tagged 'fabric-preview' always show them. Turn off once colours are Live." },
    { "type": "header", "content": "Before ordering opens" },
    { "type": "checkbox", "id": "prices_before_live", "label": "Show prices before any colour is Live", "default": false },
    { "type": "text", "id": "no_price_text", "label": "Price text before ordering opens", "default": "Coming soon" },
    { "type": "richtext", "id": "coming_soon_note", "label": "Note shown before ordering opens", "default": "<p>Ordering opens soon. Explore our fabrics and colours now, and get in touch if you'd like to reserve this piece.</p>" },
    { "type": "text", "id": "coming_soon_button", "label": "Button text before ordering opens", "default": "Coming soon" },
    { "type": "text", "id": "coming_soon_status", "label": "Fabric note before ordering opens", "default": "Available to order soon." },
    { "type": "richtext", "id": "no_fabrics_text", "label": "Text when no fabrics are available", "default": "<p>Fabrics for this piece are being finalised.</p>" },
    { "type": "header", "content": "Swatches" },
    { "type": "product", "id": "swatch_product", "label": "Swatch product", "info": "Leave blank to use the product with handle 'furniture-fabric-swatch'" },
