{% comment %}
  Atelier homepage: made-to-measure panel. Photo on one side; heading, text, numbered steps (blocks),
  an optional note (e.g. lead time) and two buttons on the other. Styles live in assets/atelier.css.
{% endcomment %}
{{ 'atelier.css' | asset_url | stylesheet_tag }}
{%- assign hf = settings.type_header_font_family -%}
<style>#atl-{{ section.id }} { --atl-heading-font: {{ hf.family }}, {{ hf.fallback_families }}; }</style>
<div class="atl" id="atl-{{ section.id }}">
  <div class="atl-w atl-pad">
    <div class="atl-feature">
      <div class="atl-feature__img">
        {%- if section.settings.image != blank -%}
          {%- assign feature_alt = section.settings.image.alt | default: section.settings.heading -%}
          {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '500, 800, 1100, 1400', sizes: '(max-width: 900px) 100vw, 55vw', alt: feature_alt }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag }}
        {%- endif -%}
      </div>
      <div class="atl-feature__text">
        {%- if section.settings.eyebrow != blank -%}<p class="atl-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="atl-h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<div class="atl-lead" style="margin-top:16px">{{ section.settings.text }}</div>{%- endif -%}
        {%- if section.blocks.size > 0 -%}
          <ol class="atl-steps">
            {%- for block in section.blocks -%}<li {{ block.shopify_attributes }}><span>{{ block.settings.text }}</span></li>{%- endfor -%}
          </ol>
        {%- endif -%}
        {%- if section.settings.note != blank -%}<p class="atl-note">{{ section.settings.note }}</p>{%- endif -%}
        <div class="atl-btns">
          {%- if section.settings.button_label != blank -%}
            <a class="atl-btn atl-btn--dark" href="{{ section.settings.button_link | default: '/pages/contact-us' }}">{{ section.settings.button_label }}</a>
          {%- endif -%}
          {%- if section.settings.button2_label != blank -%}
            <a class="atl-btn atl-btn--line" href="{{ section.settings.button2_link | default: '/collections/all' }}">{{ section.settings.button2_label }}</a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Atelier made to measure",
  "class": "atelier-section",
  "max_blocks": 5,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Made to measure" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your fabric, made up in our workshop" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Curtains, Roman blinds, cushions, headboards and full re-upholstery, finished by hand.</p>" },
    { "type": "text", "id": "note", "label": "Note", "info": "For example your usual lead time. Leave blank to hide." },
    { "type": "text", "id": "button_label", "label": "First button label", "default": "Request a quote" },
    { "type": "url", "id": "button_link", "label": "First button link", "info": "Leave blank for the contact page." },
    { "type": "text", "id": "button2_label", "label": "Second button label", "default": "Fabric calculator" },
    { "type": "url", "id": "button2_link", "label": "Second button link" }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Choose your fabric online or in the shop" } ] }
  ],
  "presets": [ { "name": "Atelier made to measure", "category": "Image", "blocks": [ { "type": "step" }, { "type": "step" }, { "type": "step" } ] } ]
}
{% endschema %}
